{
  "name": "table-os-scry-dev",
  "private": true,
  "description": "Dev tooling for TableOS Scry. Not deployed; deploy.bat uploads scripts, styles and module.json only.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=scripts/**/*.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
